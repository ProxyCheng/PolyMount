# Internal-only notes and diagnostics. They stay in the working tree on the
# machines that need them, but they must never reach the public repository:
# AGENTS.md and docs/ name internal hosts and handover details, and the two
# scripts drive local diagnostics. The publication lineage excludes them.
/AGENTS.md
/docs/
/.claude/
/scripts/Test-WarmPackage.py
/scripts/Test-EngineStartup.ps1
# The publication guard names the internal tokens it looks for; it stays local.
/scripts/Check-PublicSafe.ps1

# A smoke run's screenshots are looked at, not kept.
/.capture/
