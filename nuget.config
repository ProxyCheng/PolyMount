<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- QtSharp.Api is not on nuget.org - each QtSharp release publishes the .nupkg as a GitHub
         Release asset. scripts/Fetch-QtSharp.ps1 downloads it (and checks its published SHA-256)
         into this folder, which is all this source needs. Run that script once per clone before
         the first restore. -->
    <add key="qtsharp" value="packages" />
  </packageSources>
</configuration>
