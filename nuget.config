<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- The QtSharp packages (the binding, its managed runtime, the Qt runtime and the Charts
         addon) are not on nuget.org - each QtSharp release publishes the .nupkg files as GitHub
         Release assets. scripts/Fetch-QtSharp.ps1 downloads them into this folder, which is all
         this source needs. Run that script once per clone before the first restore. -->
    <add key="qtsharp" value="packages" />
  </packageSources>
</configuration>
