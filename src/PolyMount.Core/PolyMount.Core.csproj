<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>PolyMount</RootNamespace>
    <AssemblyName>PolyMount.Core</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="winfsp-msil">
      <HintPath>C:\Program Files (x86)\WinFsp\bin\winfsp-msil.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PolyMount.Plugin.Abstractions\PolyMount.Plugin.Abstractions.csproj" />
    <!-- The contract's namespace is imported for the whole project: the engine implements and
         consumes it everywhere, and naming it in ninety files would say nothing a reader of the
         csproj cannot see here. A file that also uses the engine's own namespace needs no second
         using for it, since that one is implicit too. -->
    <Using Include="PolyMount.Plugins" />
    <Using Include="PolyMount.Plugins.Ipc" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Core\OriginPalette.inc" LogicalName="PolyMount.OriginPalette" />
    <EmbeddedResource Include="Core\OverlayGlyphs.inc" LogicalName="PolyMount.OverlayGlyphs" />
    <EmbeddedResource Include="Resources\layer-texts.json" LogicalName="PolyMount.LayerTexts" />
    <InternalsVisibleTo Include="PolyMount.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

</Project>
