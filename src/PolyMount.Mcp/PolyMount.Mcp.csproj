<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>PolyMount.Mcp</AssemblyName>
    <RootNamespace>PolyMount.Mcp</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Shared with the tray, the service and the setup wizard; see scripts/Build-AppIcon.ps1. -->
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- The MCP implementation. Core is Microsoft's protocol types and the stdio transport is in
         the main package, which is the one that carries the hosting extensions. -->
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <!-- The MCP package brings Hosting.Abstractions only; a real host needs the implementation. -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PolyMount.Core\PolyMount.Core.csproj" />
  </ItemGroup>

</Project>
