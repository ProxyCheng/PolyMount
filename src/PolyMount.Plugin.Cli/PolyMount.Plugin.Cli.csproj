<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>PolyMount.Plugin.Cli</AssemblyName>
    <RootNamespace>PolyMount.Plugin.Cli</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>poly</ToolCommandName>
    <PackageId>PolyMount.Plugin.Cli</PackageId>
    <Description>Checks, runs and packages a PolyMount plugin.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PolyMount.Plugin.Abstractions\PolyMount.Plugin.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="PolyMount.Plugins" />
    <Using Include="PolyMount.Plugins.Ipc" />
  </ItemGroup>
</Project>
