<Project>
  <!--
    The plugin SDK: what a plugin project imports to be a plugin.

    It does three things and knows nothing else about the plugin. It stamps the assembly with the
    contract version it was compiled against, embeds the plugin's manifest into it, and records
    both in the assembly's version resource. All three are facts the build can establish and an
    author should not have to remember.

    **A plugin is one file.** The manifest is embedded as a resource (name
    `PolyMount.Plugin.Manifest`, read by the host out of the file's metadata) and the contract
    version is in the version resource (`Comments`), so what a build produces is a DLL somebody
    copies into `plugins\` — no manifest beside it, no sidecar, no deps file. `plugin.json` stays
    in the source tree: that is what its author edits, and what the host still reads for a plugin
    published before the resource existed.

    A plugin declares:
      <PluginApiVersion>4.2</PluginApiVersion>   (optional; defaults to the SDK's own)
      plugin.json                                (its manifest, beside the csproj)
  -->
  <PropertyGroup>
    <!-- The contract version this SDK packages. A plugin that leaves it alone gets this one; a
         plugin built against an older SDK keeps its own. -->
    <PluginApiVersion Condition="'$(PluginApiVersion)' == ''">4.2</PluginApiVersion>
    <GeneratePluginApiAttribute Condition="'$(GeneratePluginApiAttribute)' == ''">true</GeneratePluginApiAttribute>
    <!-- One file: a dependency file describes how to lay a program out beside itself, and a
         plugin is loaded into a host that has already done that. -->
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

  <!-- What a person reads in Explorer's properties, and what the setup's wizard reads without
       loading anything: the two facts about a plugin file that are not its own version. Both are
       carried in the version resource, which Windows PowerShell and any file browser can read —
       the assembly's own metadata cannot be read by the setup, whose script runs under a runtime
       that cannot load a .NET 10 assembly at all. -->
  <PropertyGroup>
    <!-- "PolyMount plugin" is how the installer recognises a file in the plugin folder as a
         plugin at all; the contract is what it compares with its own. Guarded on the marker
         because the two lines below are evaluated in order: the first one sets the value the
         second one would otherwise append to. -->
    <Description Condition="'$(Description)' == ''">PolyMount plugin; contract=$(PluginApiVersion)</Description>
    <Description Condition="'$(Description)' != '' and !$(Description.Contains('PolyMount plugin; contract='))">$(Description) · PolyMount plugin; contract=$(PluginApiVersion)</Description>
  </PropertyGroup>

  <!-- The attribute the host reads before it touches any type in the plugin. Written into the
       intermediate directory rather than into the source tree: it is a build product, and an
       author who could edit it would only be lying to themselves. -->
  <Target Name="GeneratePluginApiVersion" BeforeTargets="BeforeCompile;CoreCompile" Condition="'$(GeneratePluginApiAttribute)' == 'true'">
    <PropertyGroup>
      <_PluginApiFile>$(IntermediateOutputPath)PluginApiVersion.g.cs</_PluginApiFile>
    </PropertyGroup>
    <WriteLinesToFile File="$(_PluginApiFile)" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="// Generated by PolyMount.Plugin.Sdk from &lt;PluginApiVersion&gt;. Do not edit.;[assembly: PolyMount.Plugins.PluginApi(&quot;$(PluginApiVersion)&quot;)]"
                      Encoding="utf-8" />
    <ItemGroup>
      <Compile Include="$(_PluginApiFile)" />
      <FileWrites Include="$(_PluginApiFile)" />
    </ItemGroup>
  </Target>

  <!-- The manifest travels inside the assembly. Embedded rather than copied beside it: a plugin
       people hand out — a private one especially — is one file to copy, and there is no second
       file to keep in step with it. -->
  <ItemGroup Condition="'$(IsPolyMountPlugin)' != 'false' And Exists('$(MSBuildProjectDirectory)\plugin.json')">
    <EmbeddedResource Include="$(MSBuildProjectDirectory)\plugin.json"
                      LogicalName="PolyMount.Plugin.Manifest" />
  </ItemGroup>

  <!-- A plugin without a manifest still loads — that is what every plugin looked like before
       there was one — but it is worth saying so at build time rather than finding out in the
       plugin page. -->
  <Target Name="WarnMissingPluginManifest" AfterTargets="Build" Condition="'$(IsPolyMountPlugin)' != 'false' And !Exists('$(MSBuildProjectDirectory)\plugin.json')">
    <Warning Text="$(MSBuildProjectName) has no plugin.json. The host will load it as a legacy plugin: no identifier, no permissions, and its name shown only once it has been enabled." />
  </Target>
</Project>
