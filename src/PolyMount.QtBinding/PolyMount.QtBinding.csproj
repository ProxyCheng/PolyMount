<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Upstream generated binding/runtime predates nullable annotations. Keep its
         compilation boundary separate from the nullable-enabled application. -->
    <Nullable>disable</Nullable>
    <QtSharpRoot>D:\QtSharp\</QtSharpRoot>
  </PropertyGroup>
  <Import Project="$(QtSharpRoot)QtSharp.Api.props" />
</Project>
