<Window x:Class="PolyMount.Tray.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PolyMount Dashboard" Height="520" Width="960"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="RefreshButton" Content="Refresh" Width="80" Margin="0,0,6,0" Click="OnRefresh"/>
            <Button x:Name="RefreshHeadButton" Content="Refresh HEAD" Width="100" Margin="0,0,6,0" Click="OnRefreshHead"/>
            <Button x:Name="MountButton" Content="Mount" Width="70" Margin="0,0,6,0" Click="OnMount"/>
            <Button x:Name="UnmountButton" Content="Unmount" Width="80" Margin="0,0,6,0" Click="OnUnmount"/>
            <Button x:Name="ClearCacheButton" Content="Clear cache" Width="90" Margin="0,0,18,0" Click="OnClearCache"/>
            <TextBlock Text="Pin rev:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox x:Name="PinBox" Width="90" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <Button x:Name="SetPinButton" Content="Set pin" Width="70" Click="OnSetPin"/>
        </StackPanel>
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap"/>
        <ListView x:Name="MountList">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" Width="90" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Mounted" Width="70" DisplayMemberBinding="{Binding Mounted}"/>
                    <GridViewColumn Header="Mount point" Width="130" DisplayMemberBinding="{Binding MountPoint}"/>
                    <GridViewColumn Header="Source" Width="70" DisplayMemberBinding="{Binding SourceType}"/>
                    <GridViewColumn Header="Rev" Width="90" DisplayMemberBinding="{Binding Revision}"/>
                    <GridViewColumn Header="Providers" Width="170" DisplayMemberBinding="{Binding ProvidersText}"/>
                    <GridViewColumn Header="Cache" Width="130" DisplayMemberBinding="{Binding CacheText}"/>
                    <GridViewColumn Header="Error" Width="200" DisplayMemberBinding="{Binding Error}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
