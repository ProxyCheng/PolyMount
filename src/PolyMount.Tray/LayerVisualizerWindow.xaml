<Window x:Class="PolyMount.Tray.LayerVisualizerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PolyMount Layer View" Height="640" Width="580"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="12">
        <Border DockPanel.Dock="Top" Background="#F3F3F3" CornerRadius="4" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="PathText" FontWeight="Bold" FontSize="14" TextWrapping="Wrap"/>
                <TextBlock x:Name="SummaryText" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#444"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Margin="0,10,0,0" Padding="8" Background="#FAFAFA"
                BorderBrush="#DDD" BorderThickness="1" CornerRadius="4">
            <WrapPanel x:Name="Legend"/>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <Canvas x:Name="Board" Background="White"/>
        </ScrollViewer>
    </DockPanel>
</Window>
