<Window x:Class="PolyMount.Tray.MountEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PolyMount 配置编辑" Height="620" Width="860"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="10">
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#555"/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="SaveBtn" Content="保存并重载" Width="110" Height="28" Margin="0,0,8,0" Click="OnSave"/>
            <Button x:Name="CancelBtn" Content="关闭" Width="80" Height="28" Click="OnCancel"/>
        </StackPanel>

        <!-- Left: mount list -->
        <DockPanel DockPanel.Dock="Left" Width="200" Margin="0,0,10,0">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                <Button x:Name="AddBtn" Content="+ 新建" Width="70" Margin="0,0,6,0" Click="OnAddMount"/>
                <Button x:Name="RemoveBtn" Content="删除" Width="60" Click="OnRemoveMount"/>
            </StackPanel>
            <TextBlock DockPanel.Dock="Top" Text="挂载实例" FontWeight="Bold" Margin="0,0,0,4"/>
            <ListBox x:Name="MountListBox" SelectionChanged="OnMountSelected"/>
        </DockPanel>

        <!-- Right: editor -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="EditorPanel" IsEnabled="False">
                <TextBlock Text="实例设置" FontWeight="Bold" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="名称" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="0" Grid.Column="1" x:Name="NameBox" Margin="0,3"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="挂载点" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="1" Grid.Column="1" x:Name="MountPointBox" Margin="0,3"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="StoreRoot" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="2" Grid.Column="1" x:Name="StoreRootBox" Margin="0,3"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="缓存上限(MB)" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="3" Grid.Column="1" x:Name="CacheMbBox" Margin="0,3"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="启用" VerticalAlignment="Center"/>
                    <CheckBox  Grid.Row="4" Grid.Column="1" x:Name="EnabledBox" Margin="0,6" VerticalAlignment="Center"/>
                </Grid>

                <TextBlock Text="数据源" FontWeight="Bold" Margin="0,12,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                        <RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="类型" VerticalAlignment="Center"/>
                    <ComboBox  Grid.Row="0" Grid.Column="1" x:Name="SourceTypeBox" Margin="0,3" SelectionChanged="OnSourceTypeChanged"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="URL (svn)" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="1" Grid.Column="1" x:Name="UrlBox" Margin="0,3"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Pinned Rev (svn)" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="2" Grid.Column="1" x:Name="PinnedBox" Margin="0,3"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Trust failures (svn)" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="3" Grid.Column="1" x:Name="TrustBox" Margin="0,3"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="用户名 (svn)" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="4" Grid.Column="1" x:Name="UserBox" Margin="0,3"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Path (dir)" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="5" Grid.Column="1" x:Name="PathBox" Margin="0,3"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="可写透传 (dir)" VerticalAlignment="Center"/>
                    <CheckBox  Grid.Row="6" Grid.Column="1" x:Name="WritableBox" Margin="0,6" VerticalAlignment="Center"/>
                </Grid>

                <TextBlock Text="层颜色（留空=自动按类型生成）" FontWeight="Bold" Margin="0,12,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="overlay" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="0" Grid.Column="1" x:Name="OverlayColorBox" Margin="0,3" TextChanged="OnColorChanged"/>
                    <Border    Grid.Row="0" Grid.Column="2" x:Name="OverlaySwatch" Margin="4,3" BorderBrush="#555" BorderThickness="1"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="cache" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="1" Grid.Column="1" x:Name="CacheColorBox" Margin="0,3" TextChanged="OnColorChanged"/>
                    <Border    Grid.Row="1" Grid.Column="2" x:Name="CacheSwatch" Margin="4,3" BorderBrush="#555" BorderThickness="1"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="svn" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="2" Grid.Column="1" x:Name="SvnColorBox" Margin="0,3" TextChanged="OnColorChanged"/>
                    <Border    Grid.Row="2" Grid.Column="2" x:Name="SvnSwatch" Margin="4,3" BorderBrush="#555" BorderThickness="1"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="dir" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="3" Grid.Column="1" x:Name="DirColorBox" Margin="0,3" TextChanged="OnColorChanged"/>
                    <Border    Grid.Row="3" Grid.Column="2" x:Name="DirSwatch" Margin="4,3" BorderBrush="#555" BorderThickness="1"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
