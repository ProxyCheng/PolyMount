<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PolyMount.Tray</AssemblyName>
    <RootNamespace>PolyMount.Tray</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Qt binding, its native glue and the Qt runtime DLLs. The package's buildTransitive
         props/targets set PlatformTarget=x64 and copy the native payload next to the executable on
         Build and on Publish, so nothing else has to know where QtSharp lives.
         Restore reads it from the "qtsharp" source in nuget.config - run scripts/Fetch-QtSharp.ps1
         first in a fresh clone. -->
    <PackageReference Include="QtSharp.Api" Version="0.1.0" />
    <!-- Qt Charts, bound by QtSharp.Charts. It is a package of its own because of what it wraps:
         Qt Charts is GPLv3-or-commercial where qtbase is LGPLv3, so nothing that does not draw a
         chart should inherit it. Its own targets copy the module's native glue and Qt6Charts.dll
         next to the executable. See NOTICE in the package and AGENTS.md before shipping. -->
    <PackageReference Include="QtSharp.Charts" Version="0.1.0" />
    <Content Include="resources\polymount.rcc" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="..\PolyMount.Core\PolyMount.Core.csproj" />
  </ItemGroup>

</Project>
