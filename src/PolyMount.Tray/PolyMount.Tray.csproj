<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PolyMount.Tray</AssemblyName>
    <RootNamespace>PolyMount.Tray</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- The same mark the sidebar draws for itself (TrayIcons), generated by scripts/Build-AppIcon.ps1
         and shared with the service and the setup wizard so one product has one icon. -->
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Qt binding (ten module assemblies, one namespace each). It brings QtSharp.Runtime (the
         managed runtime and the native glue) and QtSharp.Qt6 (the Qt runtime DLLs and the platform
         plugin) as dependencies; their buildTransitive props/targets set PlatformTarget=x64 and copy
         the native payload next to the executable on Build and on Publish, so nothing else has to
         know where QtSharp lives. Restore reads all of them from the "qtsharp" source in
         nuget.config - run scripts/Fetch-QtSharp.ps1 first in a fresh clone. -->
    <PackageReference Include="QtSharp.Api" Version="0.2.0" />
    <!-- Qt Charts, bound by QtSharp.Charts. It is a package of its own because of what it wraps:
         Qt Charts is GPLv3-or-commercial where qtbase is LGPLv3, so nothing that does not draw a
         chart should inherit it. Its own targets copy the module's native glue; Qt6Charts.dll comes
         from its QtSharp.Charts.Qt6 dependency. See NOTICE in the package and AGENTS.md before
         shipping. -->
    <PackageReference Include="QtSharp.Charts" Version="0.2.0" />
    <Content Include="resources\polymount.rcc" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="..\PolyMount.Core\PolyMount.Core.csproj" />
  </ItemGroup>

</Project>
