<Window x:Class="PolyMount.Tray.StatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PolyMount Stats (layer hit rate / access cost)" Height="600" Width="760"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Window:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="WindowBox" Width="140" SelectionChanged="OnWindowChanged">
                <ComboBoxItem Content="Last 1 minute" Tag="60"/>
                <ComboBoxItem Content="Last 5 minutes" Tag="300" IsSelected="True"/>
                <ComboBoxItem Content="Last 15 minutes" Tag="900"/>
                <ComboBoxItem Content="Last 1 hour" Tag="3600"/>
            </ComboBox>
            <Button x:Name="RefreshBtn" Content="Refresh" Width="70" Margin="12,0,0,0" Click="OnRefresh"/>
        </StackPanel>
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,8,0,0" Foreground="#555"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Board"/>
        </ScrollViewer>
    </DockPanel>
</Window>
