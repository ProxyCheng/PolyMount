/* PolyMount's theme, written in tokens.
   Every colour is a token name that TrayTheme fills in per scheme; a literal colour here would be a
   colour that cannot change when the lights go off. The light scheme's values are exactly the ones
   this file used to carry inline. A token is spelled with an at-sign in front of it, and a name the
   theme does not know stops the tray rather than painting nothing, so a typo is found at once. */

QWidget { font-family: "Segoe UI", "Microsoft YaHei UI"; font-size: 13px; color: @Body; }
QDialog, QMessageBox, QDialog#layerPicker { background: @AppBackground; }
QMenu { background: @Surface; color: @Text; border: 1px solid @Border; padding: 4px; }
QMenu::item { padding: 7px 22px 7px 14px; border-radius: 6px; }
QMenu::item:selected { background: @PrimarySoft; color: @SelectedText; }
QMenu::separator { height: 1px; background: @Border; margin: 5px 8px; }

QWidget#pickerPreview { background: @Surface; border: 1px solid @Border; border-radius: 12px; }
QWidget#pickerPlacement { background: @SurfaceSunken; border: 1px solid @Border; border-radius: 8px; }
QLabel#pickerType { color: @Muted; font-size: 11px; }
QLabel#pickerCardTitle { font-size: 14px; font-weight: 600; color: @Text; }
QListWidget#layerCatalog { background: transparent; border: none; padding: 0; }
QListWidget#layerCatalog::item { background: transparent; border: none; padding: 0; }
QListWidget#layerCatalog::item:selected { background: transparent; }
QListWidget#layerCatalog::item:focus { border: 1px solid @Primary; border-radius: 9px; }
QWidget#dashboard { background: @AppBackground; }
QWidget#surface { background: @Surface; border: 1px solid @Border; border-radius: 12px; }
QWidget#sidebar { background: @Sidebar; }
QLabel { background: transparent; border: none; }
QLabel#sidebarMuted { color: @SidebarMuted; font-size: 12px; }
QLabel#navActive { color: @SidebarText; background: @SidebarActive; border-radius: 8px; padding: 12px; font-weight: 600; }
QLabel#serviceBadge { font-weight: 600; padding: 6px 0; }
QLabel#pageTitle { color: @Text; font-size: 26px; font-weight: 700; }
QLabel#sectionTitle { font-size: 16px; font-weight: 600; }
QPushButton#sectionToggle { background: transparent; border: none; text-align: left; padding: 2px 0; font-size: 16px; font-weight: 600; color: @Text; }
QPushButton#sectionToggle:hover { color: @Primary; }
QPushButton#sectionToggle:pressed { color: @PrimaryPressed; }
QPushButton#sectionToggle:focus { border: none; color: @Primary; }
QLabel#detailTitle { font-size: 21px; font-weight: 700; color: @Text; }
QLabel#muted, QLabel#metricHint { color: @Muted; font-size: 12px; }
QLabel#metricValue { font-size: 28px; font-weight: 700; color: @Text; }
QLabel#eyebrow { color: @Muted; font-size: 11px; font-weight: 600; padding-top: 7px; }
QLabel#detailValue { color: @Body; font-size: 13px; }
QLabel#layerChain { background: @SurfaceAlt; border: 1px solid @Border; border-radius: 8px; padding: 12px; color: @Body; }
QLabel#emptyState { color: @Muted; padding: 12px; font-size: 14px; }
QLabel#errorBox { color: @Danger; background: @DangerSoft; border-radius: 8px; padding: 12px; }
QLabel#credentialWarning { color: @Danger; background: @DangerSoft; border-radius: 6px; padding: 6px 8px; }
/* What is wrong with one field, under that field: red enough to be found while reading down a
   form, and absent when there is nothing wrong, so the form carries no red at rest. */
QLabel#fieldError { color: @Danger; font-size: 12px; padding: 0 2px; }
QPushButton { background: @Surface; border: 1px solid @BorderStrong; border-radius: 7px; padding: 9px 13px; font-weight: 600; color: @Text; }
QPushButton:hover { background: @HoverSoft; border-color: @AccentBorder; }
QPushButton:pressed { background: @PrimaryTint; }
QPushButton:focus { border: 1px solid @Primary; }
QPushButton:disabled { background: @DisabledBackground; color: @Disabled; border-color: @BorderSoft; }
/* A credential field reads as an input that opens a chooser: same frame as a line edit, with its
   text against the left edge. */
QPushButton#credentialButton { background: @Surface; border: 1px solid @BorderStrong; border-radius: 7px; padding: 8px 10px; font-weight: 400; text-align: left; color: @Text; }
QPushButton#credentialButton:hover { background: @HoverSoft; border-color: @AccentBorder; }
QPushButton#credentialButton:pressed { background: @PrimaryTint; }
QPushButton#credentialButton:focus { border: 1px solid @Primary; }
QPushButton#primary { background: @Primary; border-color: @Primary; color: @OnPrimary; }
QPushButton#primary:hover { background: @PrimaryHover; }
QPushButton#primary:pressed { background: @PrimaryPressed; }
QPushButton#primary:disabled { background: @PrimaryDisabled; border-color: @PrimaryDisabled; color: @OnPrimary; }
QPushButton#navButton { background: transparent; border: 1px solid @SidebarBorder; color: @SidebarText; text-align: left; padding: 10px 12px; }
QPushButton#navButton:hover { background: @SidebarActive; border-color: @AccentBorder; }
QPushButton#navButton:disabled { color: @SidebarDisabled; border-color: @SidebarBorder; }
QLineEdit, QComboBox { background: @Surface; border: 1px solid @BorderStrong; border-radius: 7px; padding: 8px 10px; color: @Text; selection-background-color: @Primary; selection-color: @OnPrimary; }
QLineEdit:focus, QComboBox:focus { border-color: @Primary; }
/* Having the keyboard is already said here with the accent border these controls take on :focus;
   the native style's dotted rectangle drawn inside them on top of that is the one indicator this
   theme does not want. `outline` is the property Qt reads exactly where that rectangle would be
   painted: "none" paints it as nothing instead of handing it to the base style.
   It is spelled on QWidget rather than on each control because that is the only selector that
   reaches it (measured: a QListWidget's own `QListWidget { outline: none }` leaves the rectangle in
   place, and so does `QAbstractItemView:focus`; `QFrame:focus` and `QWidget:focus` both take it
   away). It is also spelled from a :focus rule rather than from the bare `QWidget` rule above, so
   that no widget counts as modified by the style sheet merely for existing. */
QWidget:focus { outline: none; }
QComboBox::drop-down { subcontrol-origin: padding; subcontrol-position: center right; width: 22px; border: none; background: transparent; }
QComboBox::down-arrow { image: url(@ChevronDown); width: 12px; height: 12px; }
QComboBox::down-arrow:disabled { opacity: 0.4; }
QLineEdit:disabled { background: @SurfaceAlt; color: @Disabled; }
QComboBox QAbstractItemView { background: @Surface; color: @Text; border: 1px solid @Border; selection-background-color: @PrimarySoft; selection-color: @SelectedText; outline: none; padding: 4px; }
QTableWidget { background: @Surface; border: none; color: @Text; selection-background-color: @PrimarySoft; selection-color: @SelectedText; }
QTableWidget::item { padding: 8px 10px; border-bottom: 1px solid @BorderSoft; }
QTableWidget::item:hover { background: @SurfaceAlt; }
QTableWidget::item:selected { background: @PrimarySoft; color: @SelectedText; }
QHeaderView::section { background: @SurfaceAlt; color: @Muted; border: none; border-bottom: 1px solid @Border; padding: 11px 10px; font-size: 12px; font-weight: 600; }
QScrollArea, QScrollArea > QWidget > QWidget { background: @Surface; border: none; }
/* The sidebar's own scroll is a window onto a fixed-width column of controls, not a surface of its
   own: the column's background is the sidebar's, so the scroll area and the viewport it puts the
   column in have to let that colour through. */
QScrollArea#sidebarScroll, QScrollArea#sidebarScroll > QWidget, QScrollArea#sidebarScroll > QWidget > QWidget { background: transparent; border: none; }
QScrollBar:vertical { background: transparent; width: 8px; margin: 0; }
QScrollBar::handle:vertical { background: @Scrollbar; border-radius: 4px; min-height: 28px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QScrollBar:horizontal { background: transparent; height: 8px; margin: 0; }
QScrollBar::handle:horizontal { background: @Scrollbar; border-radius: 4px; min-width: 28px; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: transparent; }
QSplitter::handle { background: transparent; border: 3px solid transparent; border-radius: 4px; width: 8px; height: 8px; }
QSplitter::handle:hover { background: @SplitterHover; border-color: @PrimaryTint; }
QSplitter::handle:pressed { background: @Primary; border-color: @PrimaryTintStrong; }
QProgressBar { background: @SurfaceSunken; border: none; border-radius: 3px; }
QProgressBar::chunk { background: @Primary; border-radius: 3px; }
QListWidget { background: @Surface; border: 1px solid @Border; border-radius: 8px; padding: 6px; color: @Text; }
QListWidget::item { padding: 12px; border-radius: 6px; }
QListWidget::item:selected { background: @PrimarySoft; color: @SelectedText; }
QToolTip { color: @TooltipText; background: @TooltipBackground; border: none; padding: 6px; }
QTabWidget#workspaceTabs::pane { border: none; background: @AppBackground; }
QTabBar { background: @SurfaceSunken; }
QTabBar::tab { background: @TabIdle; color: @Muted; border: 1px solid transparent; border-top-left-radius: 8px; border-top-right-radius: 8px; padding: 10px 20px 10px 16px; margin: 4px 3px 0 0; min-width: 72px; }
QTabBar::tab:selected { background: @Surface; color: @SelectedText; border-color: @BorderStrong; border-bottom: 2px solid @Primary; }
QTabBar::tab:hover { background: @HoverSoft; }
QPushButton#tabClose { background: transparent; border: none; border-radius: 5px; padding: 0; }
QPushButton#tabClose:hover { background: @PrimaryTint; }
QPushButton#tabClose:pressed { background: @PrimaryTintStrong; }
QTabBar QToolButton { background: @SurfaceSunken; border: 1px solid @BorderStrong; border-radius: 6px; margin: 4px 1px; padding: 3px; width: 22px; }
QTabBar QToolButton:hover { background: @PrimaryTint; border-color: @AccentBorder; }
QTabBar QToolButton:pressed { background: @PrimaryTintStrong; }
QTabBar QToolButton:disabled { background: @AppBackground; border-color: @BorderSoft; }
QTabBar QToolButton::left-arrow { image: url(@ChevronLeft); width: 14px; height: 14px; }
QTabBar QToolButton::right-arrow { image: url(@ChevronRight); width: 14px; height: 14px; }
QCheckBox { spacing: 8px; background: transparent; padding: 3px 0; color: @Text; }
QCheckBox:disabled { color: @Disabled; }
QCheckBox::indicator { width: 16px; height: 16px; border: 1px solid @ControlBorder; border-radius: 4px; background: @Surface; }
QCheckBox::indicator:hover { border-color: @Primary; background: @HoverSoft; }
/* The one control whose "focused" is not a border around the whole control: the keyboard is on it
   when the box itself takes the accent. */
QCheckBox::indicator:focus { border-color: @Primary; }
QCheckBox::indicator:checked { background: @Primary; border-color: @Primary; image: url(:/polymount/check.png); }
QCheckBox::indicator:checked:hover { background: @PrimaryHover; border-color: @PrimaryHover; }
QCheckBox::indicator:pressed { background: @PrimaryTint; border-color: @Primary; }
QCheckBox::indicator:checked:pressed { background: @PrimaryPressed; border-color: @PrimaryPressed; }
QCheckBox::indicator:disabled { background: @AppBackground; border-color: @BorderStrong; }
QCheckBox::indicator:checked:disabled { background: @PrimaryDisabled; border-color: @PrimaryDisabled; }
QCheckBox::indicator:indeterminate { background: @Primary; border: 5px solid @PrimaryTint; }

/* Plugins: a row is a list line, not a card — the hairline between two of them is what makes a
   stack of rows read as one list, and the row itself stays transparent so the surface around it
   is the only background. */
QWidget#pluginRow { background: transparent; }
QLabel#pluginName { color: @Text; font-size: 14px; font-weight: 600; }
QLabel#pluginPath { color: @Muted; font-size: 12px; }
QLabel#pluginContribution { color: @Body; font-size: 12px; }
QLabel#pluginState { font-size: 13px; }
QFrame#pluginSeparator { color: @BorderSoft; background: @BorderSoft; border: none; max-height: 1px; }
QPushButton#linkDanger { background: transparent; border: none; color: @Muted; padding: 5px 8px; }
QPushButton#linkDanger:hover { color: @DangerStrong; background: @DangerSoft; border-radius: 6px; }
QPushButton#linkDanger:disabled { color: @Disabled; background: transparent; }
QWidget#pluginRow:hover { background: @HoverSoft; border-radius: 8px; }
/* A plugin's unfolded body is a sunken band inside its row, not a card of its own: the row is the
   thing the reader clicked, and what opened belongs to it. */
QWidget#pluginBody { background: @SurfaceSunken; border: 1px solid @BorderSoft; border-radius: 10px; }
QLabel#panelHeading { color: @Text; font-size: 13px; font-weight: 600; }
QLabel#rowTitle { color: @Text; font-size: 13px; font-weight: 600; }
QLabel#detailLabel { color: @Muted; font-size: 12px; }
QLabel#detailValue { color: @Body; font-size: 12px; }
QPushButton#iconButton { background: transparent; border: 1px solid transparent; border-radius: 6px; padding: 6px; }
QPushButton#iconButton:hover { background: @HoverSoft; border-color: @Border; }
QPushButton#iconButton:pressed { background: @PrimaryTint; }
QPushButton#iconButton:disabled { background: transparent; }
