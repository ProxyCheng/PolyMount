<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\PolyMount.Plugin.Abstractions\PolyMount.Plugin.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PolyMount.Plugin.Smb.Tests" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\plugin-texts.json" LogicalName="PolyMount.Plugin.Smb.Texts" />
  </ItemGroup>

  <ItemGroup>
    <!-- The plugin contract's namespace, imported for the whole project. -->
    <Using Include="PolyMount.Plugins" />
    <Using Include="PolyMount.Plugins.Ipc" />
  </ItemGroup>
  <Import Project="..\..\PolyMount.Plugin.Sdk\targets\PolyMount.Plugin.Sdk.targets" />
</Project>
