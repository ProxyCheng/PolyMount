<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\PolyMount.Plugin.Abstractions\PolyMount.Plugin.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PolyMount.Plugin.TxFShim.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- The text table is embedded, so the plugin is still one assembly to copy. -->
    <EmbeddedResource Include="Resources\plugin-texts.json" LogicalName="PolyMount.Plugin.TxFShim.Texts" />
  </ItemGroup>
  <!-- The native half ships beside the assembly; scripts\Build-TxFShim.ps1 puts it in native\.
       A checkout without the C++ build publishes the plugin without it, and install refuses,
       which is the right failure for a shim that could not start anything. The probe is a test
       tool and never ships. -->
  <ItemGroup>
    <Content Include="native\**\*" Exclude="native\probe\**;native\*.obj" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The plugin contract's namespace, imported for the whole project. -->
    <Using Include="PolyMount.Plugins" />
    <Using Include="PolyMount.Plugins.Ipc" />
  </ItemGroup>
  <Import Project="..\..\PolyMount.Plugin.Sdk\targets\PolyMount.Plugin.Sdk.targets" />
</Project>
