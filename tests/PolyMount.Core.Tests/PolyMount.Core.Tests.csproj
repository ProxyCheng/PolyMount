<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>PolyMount.Core.Tests</RootNamespace>
    <AssemblyName>PolyMount.Core.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.6.4" />
    <PackageReference Include="MSTest.TestFramework" Version="3.6.4" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PolyMount.Core\PolyMount.Core.csproj" />
    <!-- A real plugin, so a test can check what a process loads: it registers a layer type and
         declares backend only. Never shipped, never published. -->
    <ProjectReference Include="..\plugins\PolyMount.Plugin.Puppet\PolyMount.Plugin.Puppet.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="winfsp-msil">
      <HintPath>C:\Program Files (x86)\WinFsp\bin\winfsp-msil.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- The plugin contract's namespace, imported for the whole project. -->
    <Using Include="PolyMount.Plugins" />
    <Using Include="PolyMount.Plugins.Ipc" />
  </ItemGroup>
</Project>
